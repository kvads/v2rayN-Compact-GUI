<Window
    x:Class="v2rayN.Desktop.Views.AddConfigurationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    Title="{x:Static resx:SimpleUiText.AddConfiguration}"
    Width="430"
    Height="250"
    CanResize="False"
    Background="#0B0E11"
    Icon="/Assets/NotifyIcon1.ico"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="22" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="White" Text="{x:Static resx:SimpleUiText.AddConfiguration}" />
        <TextBlock Grid.Row="1" Margin="0,7,0,14" Foreground="#9CA3AF" Text="{x:Static resx:SimpleUiText.PasteConfigurationLink}" TextWrapping="Wrap" />
        <TextBox
            x:Name="ConfigurationText"
            Grid.Row="2"
            MinHeight="62"
            Padding="12"
            AcceptsReturn="True"
            TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Width="96" Height="40" Click="Cancel_Click" Content="{x:Static resx:ResUI.TbCancel}" />
            <Button Width="110" Height="40" Click="Add_Click" Content="{x:Static resx:SimpleUiText.Add}" />
        </StackPanel>
    </Grid>
</Window>
